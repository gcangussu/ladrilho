# The trainer's environment [Z11-5]. Compiled into requirements.txt by
#
#   uv pip compile --generate-hashes --python-version 3.12 \
#     --python-platform x86_64-apple-darwin requirements.in -o requirements.txt
#
# torch 2.2.2 is the last release with a macOS x86_64 wheel. That build was
# compiled against NumPy 1, and the trainer calls `tensor.numpy()`, so NumPy
# is pinned to 1.26 beside it. pytest runs `test:train`.
torch==2.2.2
numpy==1.26.4
pytest==8.3.5
