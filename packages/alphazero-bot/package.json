{
  "name": "alphazero-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A player trained from scratch by self-play on the Rust engine (spec 0011).",
  "exports": {
    "./web": "./web/index.ts",
    "./web/settings": "./web/settings.ts"
  },
  "scripts": {
    "test": "cargo test --locked && cargo test --locked --manifest-path web/Cargo.toml && node tools/web.mjs && vitest run",
    "typecheck": "node tools/web.mjs && tsc --noEmit && cargo clippy --locked --all-targets -- -D warnings && cargo clippy --locked --all-targets --manifest-path web/Cargo.toml -- -D warnings",
    "test:train": "cargo build --locked && cargo test --locked --test selfplay a_sample_round_trips && bash train/venv.sh -m pytest -q tests",
    "train": "node tools/bundle.mjs && node node_modules/.alphazero/cli.mjs train",
    "stop-simulation": "node tools/bundle.mjs && node node_modules/.alphazero/cli.mjs stop-simulation",
    "milestone": "node tools/bundle.mjs && node node_modules/.alphazero/cli.mjs milestone",
    "panel": "node tools/bundle.mjs && node node_modules/.alphazero/cli.mjs panel",
    "gate": "node tools/bundle.mjs && node node_modules/.alphazero/cli.mjs gate",
    "latency": "node tools/bundle.mjs && node node_modules/.alphazero/cli.mjs latency",
    "latency-corpus": "node tools/bundle.mjs && node node_modules/.alphazero/cli.mjs latency-corpus",
    "throughput": "node tools/bundle.mjs && node node_modules/.alphazero/cli.mjs throughput",
    "augment-fixtures": "node tools/bundle.mjs && node node_modules/.alphazero/cli.mjs augment-fixtures",
    "pool": "node tools/bundle.mjs && node node_modules/.alphazero/cli.mjs pool",
    "anchors": "node tools/bundle.mjs && node node_modules/.alphazero/cli.mjs anchors",
    "ship": "node tools/bundle.mjs && node node_modules/.alphazero/cli.mjs ship",
    "past-deal": "node tools/bundle.mjs && node node_modules/.alphazero/cli.mjs past-deal",
    "climb": "node tools/bundle.mjs && node node_modules/.alphazero/cli.mjs climb",
    "web": "node tools/web.mjs",
    "web-latency": "node tools/web.mjs && node tools/bundle.mjs && node node_modules/.alphazero/web-latency.mjs",
    "tile": "node tile/bundle.mjs && node node_modules/.alphazero/tile.mjs",
    "grzhx": "node grzhx/bundle.mjs && node node_modules/.alphazero/grzhx.mjs",
    "test:grzhx": "vitest run --config grzhx/vitest.config.ts"
  },
  "dependencies": {
    "engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "bot": "workspace:*",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
