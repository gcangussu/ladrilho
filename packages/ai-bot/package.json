{
  "name": "ai-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The expert: a port of a published AlphaZero-style Azul player (spec 0008).",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "weights": "bash tools/venv.sh tools/export_weights.py",
    "fixtures": "node tools/export-positions.mjs && bash tools/venv.sh tools/generate_fixtures.py",
    "gate": "node gate/run.mjs"
  },
  "dependencies": {
    "engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "bot": "workspace:*",
    "esbuild": "^0.28.2"
  }
}
